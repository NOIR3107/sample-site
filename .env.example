# Copy to .env.local for local development, or add these in your host's
# dashboard (Vercel: Settings > Environment Variables, Netlify: Site
# configuration > Environment variables). Both are optional.

# Where the booking form posts. Any endpoint that accepts a form POST works
# (Formspree, Web3Forms, Basin, your own API). Without it, "Request my visit"
# opens the visitor's email app with the request filled in instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Your real domain once you have one, e.g. https://www.yourcompany.com
# Used for canonical links, social previews, the sitemap and robots.txt.
# If empty, the Vercel or Netlify production URL is used automatically.
NEXT_PUBLIC_SITE_URL=
